{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "workspace",
      "type": "column",
      "children": [
        {
          "id": "topbar",
          "type": "block",
          "content": {
            "mod": "nm-nav"
          },
          "size": {
            "px": 38
          },
          "window_drag": true
        },
        {
          "id": "body",
          "type": "row",
          "children": [
            {
              "id": "sidebar",
              "type": "column",
              "children": [
                {
                  "id": "brand",
                  "type": "block",
                  "content": {
                    "mod": "nm-logo"
                  },
                  "size": {
                    "px": 44
                  },
                  "window_drag": true
                },
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "spaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents"
                  },
                  "size": {
                    "weight": 2
                  },
                  "min": 120
                }
              ],
              "size": {
                "px": 264
              },
              "min": 44,
              "max": 460,
              "background": "chrome"
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "stack",
              "children": [
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                },
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "agent",
                  "type": "block",
                  "content": {
                    "mod": "agent-progress"
                  }
                }
              ],
              "active": "agent",
              "size": {
                "px": 340
              },
              "min": 240,
              "max": 800
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ]
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    12,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "preview": "layouts/dev-layout.png"
}
